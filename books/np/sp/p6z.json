[{"c": "n52", "s": "말", "t": ["갈리치아", "폴란드 분할로 오스트리아가 얻은 땅. 1815년 오스트리아에 남았다."]}, {"c": "n52", "s": "말", "t": ["포즈난", "1815년 프로이센에 남은 폴란드 서부의 땅."]}, {"c": "n53", "s": "말", "t": ["디뉴", "알프스 남쪽의 작은 도시. 황제가 지난 산길의 한 곳."]}, {"c": "n53", "s": "말", "t": ["톨렌티노", "뮈라가 오스트리아군에 진 이탈리아의 마을."]}, {"c": "n55", "s": "말", "t": ["몽생장 고지", "웰링턴의 군대가 자리 잡은 브뤼셀 남쪽의 고지."]}, {"c": "n55", "s": "말", "t": ["샤를루아", "1815년 6월 15일 북부군이 상브르강을 건넌 도시."]}, {"c": "n54", "s": "말", "t": ["샹드마르스", "5월 광장이 열린 파리의 연병장."]}]